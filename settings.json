{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash",
      "WebSearch",
      "WebFetch",
      "Write(//Users/smittyweygant/Obsidian/Smitty's Vault/Inbox.md)",
      "Edit(//Users/smittyweygant/Obsidian/Smitty's Vault/Inbox.md)",
      "Write(//Users/smittyweygant/Obsidian/Smitty's Vault/Daily/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md)",
      "Edit(//Users/smittyweygant/Obsidian/Smitty's Vault/Daily/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md)"
    ],
    "deny": [
      "Edit(//Users/smittyweygant/Obsidian/Smitty's Vault/.obsidian/**)",
      "Read(//Users/smittyweygant/.aws/login/**)",
      "Read(//Users/smittyweygant/.aws/cli/cache/**)",
      "Bash(aws login*)",
      "Bash(aws configure export-credentials*)",
      "Bash(aws * --profile default*)",
      "Bash(aws * --profile admin*)",
      "Bash(*AWS_PROFILE=default*)",
      "Bash(*AWS_PROFILE=admin*)",
      "Bash(aws * --profile readonly*)",
      "Bash(*AWS_PROFILE=readonly*)",
      "Bash(*.aws/login/cache*)",
      "Bash(*.aws/cli/cache*)",
      "Read(//Users/smittyweygant/.aws/sso/cache/**)",
      "Bash(aws sso login*)",
      "Bash(aws sso get-role-credentials*)",
      "Bash(*.aws/sso/cache*)",
      "Bash(aws-elevate)",
      "Bash(aws-elevate *)",
      "Bash(~/.local/bin/aws-elevate*)",
      "Bash(claude-elevate)",
      "Bash(claude-elevate *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude-personal}/hooks/check-config-sync.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude-work}/hooks/pre-akka-push.sh\""
          }
        ]
      }
    ]
  }
}
